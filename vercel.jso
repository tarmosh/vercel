    ]
  }), []);

  // Cookie banner state
  const [cookieOk, setCookieOk] = useState<boolean>(true);
  useEffect(() => {
    const v = localStorage.getItem("enam_cookie_ok");
    setCookieOk(v === "1");
  }, []);

